{
  "name": "crumbl-js",
  "version": "6.6.0",
  "description": "Secure data storage with trusted third-parties to use in Javascript environment",
  "main": "dist/lib/src/typescript/index.js",
  "types": "dist/lib/src/typescript/index.d.ts",
  "scripts": {
    "compile": "eslint lib/**/*.ts && tsc",
    "fix": "eslint lib/**/*.ts --fix",
    "test": "tsc && node esbuild.browser.mjs && live-server --port=10001 --mount=/:test/src",
    "test-browser": "tsc && node esbuild.browser.mjs && live-server --port=10001 --mount=/:test/src",
    "test-node": "tsc && esbuild test/src/typescript/node.spec.ts --bundle --outfile=dist/test/node.spec.cjs --platform=node --format=cjs --external:keccak --external:secp256k1 --external:mocha && mocha dist/test/node.spec.cjs",
    "test:ci": "npm run test-node && npm audit --omit=dev --audit-level=moderate",
    "fix-test": "eslint test/**/*.ts --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyrildever/crumbl-js.git"
  },
  "keywords": [
    "crypto",
    "cryptography",
    "crumbl",
    "data protection",
    "secure storage",
    "third-party",
    "data masking"
  ],
  "author": "Cyril Dever <cdever@pep-s.com>",
  "license": "BSD-2-Clause-Patent",
  "bugs": {
    "url": "https://github.com/cyrildever/crumbl-js/issues"
  },
  "homepage": "https://github.com/cyrildever/crumbl-js#readme",
  "dependencies": {
    "buffer-xor": "~2.0.2",
    "ecies-geth": "^1.8.0",
    "feistel-cipher": "^1.6.0",
    "seedrandom": "3.0.5"
  },
  "peerDependencies": {
    "blakejs": "^1.2.1",
    "keccak": "^3.0.4",
    "sha3": "^2.1.4"
  },
  "devDependencies": {
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@esbuild-plugins/node-modules-polyfill": "^0.2.2",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.2",
    "@types/buffer-xor": "^2.0.2",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.3",
    "@types/seedrandom": "^3.0.8",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "blakejs": "^1.2.1",
    "chai": "^6.2.2",
    "crypto-browserify": "^3.12.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.2",
    "eslint-plugin-no-loops": "~0.4.0",
    "globals": "^17.0.0",
    "keccak": "^3.0.4",
    "mocha": "^11.7.6",
    "sha3": "^2.1.4",
    "typescript": "^6.0.3"
  }
}
